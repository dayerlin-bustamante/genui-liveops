# ─────────────────────────────────────────────────────────────
# Proveedor LLM: "claude" | "openai" | "mock"
# - claude → usa ANTHROPIC_API_KEY (recomendado, es el default)
# - openai → usa OPENAI_API_KEY
# - mock   → NO requiere ninguna key (demo offline, streams simulados)
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER=mock

# API keys (solo necesarias si LLM_PROVIDER no es "mock")
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Modelo por defecto según proveedor (se puede omitir y usa el del código)
# claude: claude-haiku-4-5  |  openai: gpt-4o-mini
LLM_MODEL=

# Servidor
PORT=3000
